# Cloudflare Pages headers.
# jobs.json / jobs-meta.json stay CORS-open so the feed can be read from
# other origins in the amlnorth family (requirements §2).
/jobs.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/jobs-meta.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# RFC 9116. Explicit so the type never depends on the host's extension map.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # Self-only. The built site loads zero external resources — Vite emits an
  # external module script and an external stylesheet, plus the tiny external
  # /theme-init.js (all same-origin, no inline <style>/<script>), the theme is
  # applied via the CSSOM (not inline styles), and the only cross-origin
  # traffic is user-initiated link navigation (job postings, LinkedIn/GitHub),
  # which CSP does not gate. The prerendered pages' JSON-LD and embedded feed
  # are <script> data blocks (application/ld+json, application/json): never
  # executed, so script-src doesn't apply and no hash/nonce is needed.
  # img-src allows data: for the inline SVG favicon fallback.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
